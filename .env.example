# Copy this file to ".env" and fill in your own values. Never commit ".env".
# MongoDB Atlas connection string (Atlas > Database > Connect > Drivers)
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster-host>.mongodb.net/?retryWrites=true&w=majority
DB_NAME=holyloy
PORT=3000
# Key for /admin.html - use a long random value
ADMIN_KEY=change-me
